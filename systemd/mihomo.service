[Unit]
Description=mihomo (Clash.Meta) proxy daemon
Documentation=https://github.com/MetaCubeX/mihomo
After=network-online.target nss-lookup.target
Wants=network-online.target

[Service]
Type=simple
# -d 指定工作目录（providers/ui 相对路径都基于它），-f 指定主配置
ExecStart=/usr/local/bin/mihomo -d /etc/mihomo -f /etc/mihomo/config.yaml
Restart=on-failure
RestartSec=5s
LimitNOFILE=1048576

# TUN 模式需要创建网卡、改路由、用 nftables 重定向，因此需要这些能力。
# 以 root 运行最省事；如需降权，可改用非 root 用户 + 保留下列 AmbientCapabilities。
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN CAP_NET_BROADCAST
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_ADMIN CAP_NET_BROADCAST

# 基础加固
NoNewPrivileges=false
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
